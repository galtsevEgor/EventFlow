{
  "openapi": "3.1.0",
  "info": { "title": "EventFlow public API", "version": "1.0.0" },
  "paths": {
    "/api/v1/organizations": {
      "get": {
        "operationId": "listOrganizations",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "organizations": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Organization" }
                    }
                  },
                  "required": ["organizations"],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      },
      "post": {
        "operationId": "createOrganization",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/OrganizationInput" } }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Organization" } }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{id}": {
      "get": {
        "operationId": "getOrganization",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Organization" } }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      },
      "patch": {
        "operationId": "renameOrganization",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/OrganizationInput" } }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Organization" } }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{id}/audit": {
      "get": {
        "operationId": "listAudit",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entries": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/AuditEntry" }
                    }
                  },
                  "required": ["entries"],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{id}/members": {
      "get": {
        "operationId": "listMembers",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "members": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Member" }
                    }
                  },
                  "required": ["members"],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{id}/members/{user}": {
      "patch": {
        "operationId": "changeRole",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          { "name": "user", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "role": { "$ref": "#/components/schemas/Role" } },
                "required": ["role"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userSubject": { "type": "string" },
                    "role": { "$ref": "#/components/schemas/Role" }
                  },
                  "required": ["userSubject", "role"],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      },
      "delete": {
        "operationId": "removeMember",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          { "name": "user", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "userSubject": { "type": "string" }, "role": { "type": "null" } },
                  "required": ["userSubject", "role"],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{id}/members/{user}/events/{eventId}": {
      "put": {
        "operationId": "assignEvent",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          { "name": "user", "in": "path", "required": true, "schema": { "type": "string" } },
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "assigned": { "type": "boolean" } },
                "required": ["assigned"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "assigned": { "type": "boolean" } },
                  "required": ["assigned"],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{id}/invitations": {
      "get": {
        "operationId": "listInvitations",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "invitations": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Invitation" }
                    }
                  },
                  "required": ["invitations"],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      },
      "post": {
        "operationId": "createInvitation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/InvitationInput" } }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/InvitationCreated" } }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{id}/invitations/{invitationId}": {
      "delete": {
        "operationId": "revokeInvitation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "invitationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "revoked": { "type": "boolean" } },
                  "required": ["revoked"],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      }
    },
    "/api/v1/invitations/accept": {
      "post": {
        "operationId": "acceptInvitation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "token": { "type": "string", "pattern": "^[\\w-]{43}$" } },
                "required": ["token"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "organizationId": { "type": "string", "format": "uuid" },
                    "role": { "$ref": "#/components/schemas/Role" }
                  },
                  "required": ["organizationId", "role"],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{id}/events": {
      "get": {
        "operationId": "listDrafts",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": { "type": "array", "items": { "$ref": "#/components/schemas/Draft" } }
                  },
                  "required": ["events"],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      },
      "post": {
        "operationId": "createDraft",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/DraftInput" } }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Draft" } }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{id}/events/{eventId}": {
      "get": {
        "operationId": "getDraft",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Draft" } }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateDraft",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/DraftInput" } }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Draft" } }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "getSession",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Session" } }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "logoutUrl": { "type": "string", "format": "uri" } },
                  "required": ["logoutUrl"],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "get": {
        "operationId": "login",
        "security": [],
        "parameters": [{ "name": "returnTo", "in": "query", "schema": { "type": "string" } }],
        "responses": {
          "302": { "description": "Redirect to Keycloak" },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      }
    },
    "/api/v1/auth/callback": {
      "get": {
        "operationId": "loginCallback",
        "security": [],
        "responses": {
          "303": { "description": "Redirect to application" },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "requestId": { "type": "string" },
          "retryable": { "type": "boolean" },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": { "type": "array", "items": { "type": "string" } }
          }
        },
        "required": ["code", "message", "requestId", "retryable"],
        "additionalProperties": false
      },
      "Role": { "type": "string", "enum": ["OWNER", "MANAGER", "STAFF"] },
      "Organization": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "role": { "$ref": "#/components/schemas/Role" }
        },
        "required": ["id", "name", "role"],
        "additionalProperties": false
      },
      "OrganizationInput": {
        "type": "object",
        "properties": { "name": { "type": "string", "minLength": 2, "maxLength": 100 } },
        "required": ["name"],
        "additionalProperties": false
      },
      "Member": {
        "type": "object",
        "properties": {
          "userSubject": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "$ref": "#/components/schemas/Role" },
          "assignments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "eventId": { "type": "string", "format": "uuid" } },
              "required": ["eventId"],
              "additionalProperties": false
            }
          }
        },
        "required": ["userSubject", "email", "role", "assignments"],
        "additionalProperties": false
      },
      "Invitation": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "role": { "$ref": "#/components/schemas/Role" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "acceptedAt": {
            "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
          },
          "revokedAt": {
            "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
          }
        },
        "required": ["id", "email", "role", "expiresAt", "acceptedAt", "revokedAt"],
        "additionalProperties": false
      },
      "InvitationInput": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "role": { "type": "string", "enum": ["MANAGER", "STAFF"] }
        },
        "required": ["email", "role"],
        "additionalProperties": false
      },
      "InvitationCreated": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "token": { "type": "string" },
          "expiresAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "token", "expiresAt"],
        "additionalProperties": false
      },
      "Draft": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "organizationId": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "organizationId", "title", "description", "createdAt"],
        "additionalProperties": false
      },
      "DraftInput": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 2, "maxLength": 160 },
          "description": { "type": "string", "maxLength": 5000 }
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "AuditEntry": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "organizationId": { "type": "string", "format": "uuid" },
          "actorSubject": { "type": "string" },
          "action": { "type": "string" },
          "targetId": { "type": "string" },
          "details": { "type": "object", "additionalProperties": true },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": [
          "id",
          "organizationId",
          "actorSubject",
          "action",
          "targetId",
          "details",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "PolicyQuery": {
        "type": "object",
        "properties": {
          "actorSubject": { "type": "string" },
          "organizationId": { "type": "string", "format": "uuid" },
          "eventId": { "type": "string", "format": "uuid" },
          "action": {
            "type": "string",
            "enum": ["events:read", "events:write", "members:manage", "check-in"]
          }
        },
        "required": ["actorSubject", "organizationId", "action"],
        "additionalProperties": false
      },
      "Identity": {
        "type": "object",
        "properties": {
          "sub": { "type": "string" },
          "email": { "type": "string" },
          "emailVerified": { "type": "boolean" },
          "name": { "type": "string" }
        },
        "required": ["sub", "email", "emailVerified", "name"],
        "additionalProperties": false
      },
      "Session": {
        "anyOf": [
          {
            "type": "object",
            "properties": { "user": { "type": "null" } },
            "required": ["user"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "user": { "$ref": "#/components/schemas/Identity" },
              "csrfToken": { "type": "string" }
            },
            "required": ["user", "csrfToken"],
            "additionalProperties": false
          }
        ]
      }
    },
    "securitySchemes": {
      "session": { "type": "apiKey", "in": "cookie", "name": "eventflow_session" }
    }
  },
  "security": [{ "session": [] }]
}
