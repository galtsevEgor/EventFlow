{
  "openapi": "3.1.0",
  "info": {
    "title": "EventFlow authentication",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/session": {
      "get": {
        "operationId": "getSession",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "logoutUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": ["logoutUrl"],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "get": {
        "operationId": "login",
        "security": [],
        "parameters": [
          {
            "name": "returnTo",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to Keycloak"
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/callback": {
      "get": {
        "operationId": "loginCallback",
        "security": [],
        "responses": {
          "303": {
            "description": "Redirect to application"
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Identity": {
        "type": "object",
        "properties": {
          "sub": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["sub", "email", "emailVerified", "name"],
        "additionalProperties": false
      },
      "Session": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "user": {
                "type": "null"
              }
            },
            "required": ["user"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "user": {
                "$ref": "#/components/schemas/Identity"
              },
              "csrfToken": {
                "type": "string"
              }
            },
            "required": ["user", "csrfToken"],
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
