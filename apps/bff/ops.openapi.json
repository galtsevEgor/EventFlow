{
  "openapi": "3.1.0",
  "info": {
    "title": "Operator API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/ops/access": {
      "get": {
        "operationId": "operatorAccess",
        "responses": {
          "200": {
            "description": "Verified operator capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsAccess"
                }
              }
            }
          },
          "401": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "403": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "404": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "409": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "422": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "503": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ops/issues": {
      "get": {
        "operationId": "operatorOverview",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["payment", "refund", "webhook", "mail"]
            }
          },
          {
            "name": "orderId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 600
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operator view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsOverview"
                }
              }
            }
          },
          "401": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "403": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "404": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "409": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "422": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "503": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ops/issues/{service}": {
      "get": {
        "operationId": "operatorIssues",
        "parameters": [
          {
            "name": "service",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["payments", "catalog", "tickets"]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["payment", "refund", "webhook", "mail"]
            }
          },
          {
            "name": "orderId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 600
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operator view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsPage"
                }
              }
            }
          },
          "401": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "403": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "404": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "409": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "422": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "503": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ops/issues/{service}/{kind}/{id}": {
      "get": {
        "operationId": "operatorDetail",
        "parameters": [
          {
            "name": "service",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["payments", "catalog", "tickets"]
            }
          },
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["payment", "refund", "webhook", "mail"]
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sanitized operator case and authoritative action history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsDetail"
                }
              }
            }
          },
          "401": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "403": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "404": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "409": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "422": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "503": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ops/issues/{service}/{kind}/{id}/recover": {
      "post": {
        "operationId": "operatorRecover",
        "parameters": [
          {
            "name": "service",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["payments", "catalog", "tickets"]
            }
          },
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["payment", "refund", "webhook", "mail"]
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpsRecovery"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Recovery accepted; final state is read from the case",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["accepted"],
                  "properties": {
                    "accepted": {
                      "type": "boolean",
                      "enum": [true]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "403": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "404": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "409": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "422": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          },
          "503": {
            "description": "Operator request rejected or temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OpsAccess": {
        "type": "object",
        "required": ["canRecover"],
        "properties": {
          "canRecover": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "OpsIssue": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "state", "code", "orderId", "recordedAt", "traceId"],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 255
          },
          "kind": {
            "type": "string",
            "enum": ["payment", "refund", "webhook", "mail"]
          },
          "state": {
            "type": "string",
            "maxLength": 60
          },
          "code": {
            "type": ["string", "null"]
          },
          "orderId": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "traceId": {
            "type": ["string", "null"]
          }
        }
      },
      "OpsPage": {
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/OpsIssue"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      },
      "OpsOverview": {
        "type": "object",
        "required": ["sources"],
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/OpsPage"
                },
                {
                  "type": "object",
                  "required": ["service", "available"],
                  "properties": {
                    "service": {
                      "type": "string",
                      "enum": ["payments", "catalog", "tickets"]
                    },
                    "available": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "OpsAction": {
        "type": "object",
        "required": ["key", "actor", "actorType", "reason", "createdAt", "traceId"],
        "properties": {
          "key": {
            "type": "string",
            "format": "uuid"
          },
          "actor": {
            "type": "string"
          },
          "actorType": {
            "type": "string",
            "enum": ["HUMAN", "SERVICE"]
          },
          "reason": {
            "type": ["string", "null"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "traceId": {
            "type": ["string", "null"]
          }
        }
      },
      "OpsOrder": {
        "type": "object",
        "required": ["id", "saleId", "state", "totalMinor", "currency", "seatCount"],
        "properties": {
          "id": {
            "type": "string"
          },
          "saleId": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "totalMinor": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "seatCount": {
            "type": "integer"
          }
        }
      },
      "OpsDetail": {
        "type": "object",
        "required": [
          "issue",
          "version",
          "recoverable",
          "facts",
          "actions",
          "order",
          "orderStatus",
          "traceUrl"
        ],
        "properties": {
          "issue": {
            "$ref": "#/components/schemas/OpsIssue"
          },
          "version": {
            "type": "string"
          },
          "recoverable": {
            "type": "boolean"
          },
          "facts": {
            "type": "object",
            "required": ["attempts", "nextRunAt"],
            "properties": {
              "amountMinor": {
                "type": "integer"
              },
              "currency": {
                "type": "string"
              },
              "bookingState": {
                "type": "string"
              },
              "attempts": {
                "type": "integer"
              },
              "nextRunAt": {
                "type": ["string", "null"]
              }
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpsAction"
            }
          },
          "order": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OpsOrder"
              },
              {
                "type": "null"
              }
            ]
          },
          "orderStatus": {
            "type": "string",
            "enum": ["available", "missing", "unavailable", "none"]
          },
          "traceUrl": {
            "type": ["string", "null"]
          }
        }
      },
      "OpsRecovery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "version"],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 8,
            "maxLength": 240
          },
          "version": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "OpsError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "requestId", "retryable"],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
