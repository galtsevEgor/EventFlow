{
  "uid": "eventflow-recommendations",
  "title": "EventFlow — recommendations",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["eventflow"],
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Projection ready",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "eventflow_recommendations_ready_ratio",
          "legendFormat": "{{component}} {{operation}} {{mode}} {{degraded}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Unprocessed source changes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "eventflow_recommendations_cursor_gap_ratio",
          "legendFormat": "{{component}} {{operation}} {{mode}} {{degraded}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Seconds since worker heartbeat",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "eventflow_recommendations_sync_age_seconds",
          "legendFormat": "{{component}} {{operation}} {{mode}} {{degraded}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "API p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(eventflow_recommendations_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{component}} {{operation}} {{mode}} {{degraded}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Recommendation modes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode, degraded) (rate(eventflow_recommendations_results_total[5m]))",
          "legendFormat": "{{component}} {{operation}} {{mode}} {{degraded}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Projection sync health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "eventflow_recommendations_projection_up_ratio",
          "legendFormat": "{{component}} {{operation}} {{mode}} {{degraded}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
