{
  "uid": "eventflow-overview",
  "title": "EventFlow — service health",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["eventflow"],
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "Trace explorer",
      "type": "link",
      "url": "/explore?left=%7B%22datasource%22%3A%22eventflow-tempo%22%7D"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "custom",
        "query": "local,staging,demo,test",
        "current": {
          "text": "staging",
          "value": "staging"
        },
        "options": [
          {
            "text": "local",
            "value": "local",
            "selected": false
          },
          {
            "text": "staging",
            "value": "staging",
            "selected": true
          },
          {
            "text": "demo",
            "value": "demo",
            "selected": false
          },
          {
            "text": "test",
            "value": "test",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Reporting processes",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eventflow-prometheus"
          },
          "expr": "sum by (service_name) (eventflow_service_up{deployment_environment_name=\"$environment\"})",
          "legendFormat": "{{service_name}} {{__name__}} {{component}} {{operation}} {{outcome}} {{state}} {{kind}} {{alertname}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP requests / second",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eventflow-prometheus"
          },
          "expr": "sum by (service_name) (rate(eventflow_http_requests_total{deployment_environment_name=\"$environment\"}[5m]))",
          "legendFormat": "{{service_name}} {{__name__}} {{component}} {{operation}} {{outcome}} {{state}} {{kind}} {{alertname}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP server error fraction",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eventflow-prometheus"
          },
          "expr": "sum by (service_name) (rate(eventflow_http_requests_total{deployment_environment_name=\"$environment\",status=~\"5..\"}[5m])) / sum by (service_name) (rate(eventflow_http_requests_total{deployment_environment_name=\"$environment\"}[5m]))",
          "legendFormat": "{{service_name}} {{__name__}} {{component}} {{operation}} {{outcome}} {{state}} {{kind}} {{alertname}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "HTTP duration p95",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eventflow-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(eventflow_http_request_duration_seconds_bucket{deployment_environment_name=\"$environment\"}[5m])))",
          "legendFormat": "{{service_name}} {{__name__}} {{component}} {{operation}} {{outcome}} {{state}} {{kind}} {{alertname}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "CPU cores used",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eventflow-prometheus"
          },
          "expr": "sum by (service_name) (rate(eventflow_process_cpu_seconds_total{deployment_environment_name=\"$environment\"}[5m]))",
          "legendFormat": "{{service_name}} {{__name__}} {{component}} {{operation}} {{outcome}} {{state}} {{kind}} {{alertname}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Process memory",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eventflow-prometheus"
          },
          "expr": "sum by (service_name) (eventflow_process_memory_bytes{deployment_environment_name=\"$environment\"})",
          "legendFormat": "{{service_name}} {{__name__}} {{component}} {{operation}} {{outcome}} {{state}} {{kind}} {{alertname}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Dependency health",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eventflow-prometheus"
          },
          "expr": "min by (service_name, component) (eventflow_dependency_up{deployment_environment_name=\"$environment\"})",
          "legendFormat": "{{service_name}} {{__name__}} {{component}} {{operation}} {{outcome}} {{state}} {{kind}} {{alertname}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "SQL query duration p95",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eventflow-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(eventflow_db_query_duration_seconds_bucket{deployment_environment_name=\"$environment\"}[5m])))",
          "legendFormat": "{{service_name}} {{__name__}} {{component}} {{operation}} {{outcome}} {{state}} {{kind}} {{alertname}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "SQL pool connections",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eventflow-prometheus"
          },
          "expr": "sum by (service_name, state) (eventflow_db_pool_connections{deployment_environment_name=\"$environment\"})",
          "legendFormat": "{{service_name}} {{__name__}} {{component}} {{operation}} {{outcome}} {{state}} {{kind}} {{alertname}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Active alerts (all environments)",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "eventflow-prometheus"
          },
          "expr": "count by (alertname, severity, deployment_environment_name) (ALERTS{alertstate=\"firing\"})",
          "legendFormat": "{{service_name}} {{__name__}} {{component}} {{operation}} {{outcome}} {{state}} {{kind}} {{alertname}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    }
  ]
}
