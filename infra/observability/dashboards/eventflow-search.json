{
  "uid": "eventflow-search",
  "title": "EventFlow — search projection",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["eventflow"],
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Projection ready",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "eventflow_search_ready",
          "legendFormat": "{{service_instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Source cursor gap",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "eventflow_search_cursor_gap",
          "legendFormat": "{{service_instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Seconds since successful feed synchronization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "eventflow_search_sync_age_seconds",
          "legendFormat": "{{service_instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Discovery HTTP p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "eventflow-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(eventflow_http_request_duration_seconds_bucket{service_name=\"search\"}[5m])))",
          "legendFormat": "{{service_instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
