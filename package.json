{
  "name": "eventflow",
  "version": "0.1.0-e0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "help": "node scripts/help.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test": "pnpm test:tooling && pnpm test:unit",
    "check:repository": "node scripts/repository-policy.mjs",
    "check": "pnpm check:repository && pnpm check:boundaries && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test",
    "dev": "turbo run dev",
    "check:boundaries": "node scripts/boundaries.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "env:init": "node scripts/local-env.mjs",
    "infra:up": "node scripts/compose.mjs up",
    "infra:down": "node scripts/compose.mjs down",
    "infra:status": "node scripts/compose.mjs status",
    "infra:check": "node scripts/compose.mjs config",
    "test:infra": "node --env-file=.env --test --test-timeout=45000 infra/tests/*.test.mjs",
    "tools:setup": "node scripts/quality-tools.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "check:workflow": "node scripts/check-workflow.mjs",
    "generate:spikes": "prisma generate --schema=spikes/booking/schema.prisma",
    "test:spikes": "pnpm generate:spikes && tsc -p spikes/tsconfig.json && tsx --env-file=.env --test --test-timeout=30000 spikes/booking/*.test.ts spikes/payments/*.test.ts",
    "audit:runtime": "pnpm audit --prod --audit-level high",
    "ci:local": "pnpm tools:setup && pnpm check:workflow && pnpm check:secrets && pnpm audit:runtime && pnpm check && pnpm build && pnpm test:smoke && pnpm env:init && pnpm infra:check && pnpm infra:up && pnpm test:infra && pnpm test:spikes"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@eslint/js": "10.0.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/node": "24.19.2",
    "amqplib": "2.2.0",
    "eslint": "10.13.0",
    "globals": "16.4.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "redis": "6.3.0",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
