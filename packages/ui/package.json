{
  "name": "@eventflow/ui",
  "version": "0.1.0-e1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').copyFileSync('src/styles.css', 'dist/styles.css')\"",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o dist/storybook --disable-telemetry"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.3.0",
    "@storybook/react-vite": "10.6.5",
    "storybook": "10.6.5",
    "vite": "8.3.5"
  }
}
