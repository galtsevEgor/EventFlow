{
  "openapi": "3.1.0",
  "info": { "title": "EventFlow Tickets", "version": "1.0.0" },
  "security": [{ "bearer": [] }],
  "paths": {
    "/api/v1/orders/{id}/tickets": {
      "get": {
        "operationId": "listOrderTickets",
        "parameters": [{ "$ref": "#/components/parameters/TicketOrderId" }],
        "responses": {
          "200": {
            "description": "Issued tickets for the authenticated buyer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["tickets"],
                  "additionalProperties": false,
                  "properties": {
                    "tickets": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/OrderTicket" }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "No tickets available to this buyer" }
        }
      }
    },
    "/api/v1/orders/{id}/tickets/{ticketId}/qr": {
      "get": {
        "operationId": "getOrderTicketQr",
        "parameters": [
          { "$ref": "#/components/parameters/TicketOrderId" },
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Private, non-cacheable ticket QR image",
            "content": { "image/png": { "schema": { "type": "string", "format": "binary" } } }
          },
          "404": { "description": "No matching ticket available to this buyer" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "bearer": { "type": "http", "scheme": "bearer" } },
    "parameters": {
      "TicketOrderId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "schemas": {
      "OrderTicket": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "row", "number", "categoryName"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "row": { "type": "integer" },
          "number": { "type": "integer" },
          "categoryName": { "type": "string" }
        }
      }
    }
  }
}
