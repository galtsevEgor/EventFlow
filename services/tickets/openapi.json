{
  "openapi": "3.1.0",
  "info": {
    "title": "EventFlow Tickets",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/api/v1/check-in": {
      "post": {
        "operationId": "checkInTicket",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckInInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The authoritative admission result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckInResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{id}/tickets": {
      "get": {
        "operationId": "listOrderTickets",
        "parameters": [
          {
            "$ref": "#/components/parameters/TicketOrderId"
          }
        ],
        "responses": {
          "200": {
            "description": "Issued tickets for the authenticated buyer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["tickets"],
                  "additionalProperties": false,
                  "properties": {
                    "tickets": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/OrderTicket"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No tickets available to this buyer"
          }
        }
      }
    },
    "/api/v1/orders/{id}/tickets/{ticketId}/code": {
      "get": {
        "operationId": "getManualTicketCode",
        "parameters": [
          {
            "$ref": "#/components/parameters/TicketOrderId"
          },
          {
            "$ref": "#/components/parameters/TicketId"
          }
        ],
        "responses": {
          "200": {
            "description": "The ticket credential for authorized manual entry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["code"],
                  "properties": {
                    "code": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{32}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{id}/tickets/{ticketId}/qr": {
      "get": {
        "operationId": "getOrderTicketQr",
        "parameters": [
          {
            "$ref": "#/components/parameters/TicketOrderId"
          },
          {
            "$ref": "#/components/parameters/TicketId"
          }
        ],
        "responses": {
          "200": {
            "description": "Private, non-cacheable ticket QR image",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "No matching ticket available to this buyer"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "TicketId": {
        "name": "ticketId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "TicketOrderId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "CheckInInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "organizationId", "eventId", "credential"],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "credential": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{32}$"
          }
        }
      },
      "CheckInResponse": {
        "type": "object",
        "required": ["result", "admittedAt"],
        "properties": {
          "result": {
            "type": "string",
            "enum": [
              "ADMITTED",
              "ALREADY_USED",
              "WRONG_EVENT",
              "INVALID_TICKET",
              "WINDOW_CLOSED",
              "REFUND_PENDING",
              "REFUNDED"
            ]
          },
          "admittedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      },
      "OrderTicket": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "row", "number", "categoryName"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "row": {
            "type": "integer"
          },
          "number": {
            "type": "integer"
          },
          "categoryName": {
            "type": "string"
          }
        }
      }
    }
  }
}
