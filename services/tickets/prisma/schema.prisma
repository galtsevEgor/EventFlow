generator client {
  provider = "prisma-client"
  output = "../src/generated"
  moduleFormat = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model DeliveryJob {
  recoveryKey String? @db.Uuid
  traceparent String? @db.VarChar(55)
  id String @id @db.Uuid
  state String @default("PENDING") @db.VarChar(10)
  attempts Int @default(0)
  nextRunAt DateTime @default(now()) @db.Timestamptz(3)
  lease String? @db.Uuid

  @@index([state, nextRunAt])
  @@index([state, nextRunAt, id])
}

model DeliveryRetry {
  traceparent String? @db.VarChar(55)
  actorType String? @db.VarChar(12)
  expectedVersion String? @db.VarChar(64)
  reason String? @db.VarChar(240)
  requestId String @id @db.Uuid
  jobId String @db.Uuid
  actorSubject String @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Ticket {
  usedAt         DateTime? @db.Timestamptz(3)
  id             String   @id @db.Uuid
  orderId        String   @db.Uuid
  seatId         String   @db.VarChar(20)
  saleId         String   @db.Uuid
  organizationId String   @db.Uuid
  buyerSubject   String   @db.VarChar(255)
  row            Int
  number         Int
  categoryName   String   @db.VarChar(60)
  qrHash         String   @unique @db.Char(64)
  qrKeyId        String   @db.VarChar(32)
  qrEncrypted    Bytes
  issuedAt       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([orderId, seatId])
}

model CheckIn {
  requestId      String    @id @db.Uuid
  requestHash    String    @db.Char(64)
  actorSubject   String    @db.VarChar(255)
  organizationId String    @db.Uuid
  eventId        String    @db.Uuid
  ticketId       String?   @db.Uuid
  result         String    @db.VarChar(16)
  admittedAt     DateTime? @db.Timestamptz(3)
  checkedAt      DateTime  @db.Timestamptz(3)

  @@index([eventId, checkedAt])
}

model Inbox {
  eventId String   @id @db.Uuid
  seenAt  DateTime @default(now()) @db.Timestamptz(3)
}
model RefundGate {
  orderId String @id @db.Uuid
  operationId String @unique @db.Uuid
  saleId String @db.Uuid
  organizationId String @db.Uuid
  state String @db.VarChar(10)
  payloadHash String? @db.Char(64)
  code String? @db.VarChar(60)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
}
model Outbox {
  id String @id @db.Uuid
  envelope Json
  availableAt DateTime @default(now()) @db.Timestamptz
  sentAt DateTime? @db.Timestamptz
  lease String? @db.Uuid
  attempts Int @default(0)
  @@index([sentAt, availableAt])
}
