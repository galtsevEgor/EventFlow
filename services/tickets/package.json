{
  "name": "@eventflow/tickets",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.json",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "generate": "prisma generate",
    "dev": "pnpm generate && tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@eventflow/event-contracts": "workspace:*",
    "@eventflow/messaging": "workspace:*",
    "@eventflow/service-runtime": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.15"
  }
}
