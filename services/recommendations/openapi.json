{
  "openapi": "3.1.0",
  "info": {
    "title": "EventFlow Recommendations API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/events/{id}/similar": {
      "get": {
        "summary": "Similar",
        "operationId": "similarEvents",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Id"
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "default": "",
              "title": "City"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "From"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "To"
            }
          },
          {
            "name": "minPriceMinor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 100000000,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Minpriceminor"
            }
          },
          {
            "name": "maxPriceMinor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 100000000,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Maxpriceminor"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 12,
              "minimum": 1,
              "default": 6,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationPage"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationError"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationError"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "RecommendationError": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "requestId": {
            "type": "string",
            "title": "Requestid"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["code", "message", "requestId", "retryable"],
        "title": "RecommendationError"
      },
      "RecommendationItem": {
        "properties": {
          "event": {
            "$ref": "#/components/schemas/SourceDocument"
          },
          "reason": {
            "type": "string",
            "enum": ["SIMILAR", "INTERESTS", "FAVORITES", "UPCOMING"],
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["event", "reason"],
        "title": "RecommendationItem"
      },
      "RecommendationPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RecommendationItem"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Items"
          },
          "mode": {
            "type": "string",
            "enum": ["similar", "personal", "upcoming"],
            "title": "Mode"
          },
          "degraded": {
            "type": "boolean",
            "title": "Degraded"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["items", "mode", "degraded"],
        "title": "RecommendationPage"
      },
      "SourceDocument": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 2,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "title": "Description"
          },
          "city": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "City"
          },
          "address": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Address"
          },
          "timeZone": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Timezone"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "title": "Startsat"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "title": "Endsat"
          },
          "localDate": {
            "type": "string",
            "format": "date",
            "title": "Localdate"
          },
          "minPriceMinor": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Minpriceminor"
          },
          "currency": {
            "type": "string",
            "const": "EUR",
            "title": "Currency"
          },
          "capacity": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Capacity"
          },
          "coverId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coverid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "city",
          "address",
          "timeZone",
          "startsAt",
          "endsAt",
          "localDate",
          "minPriceMinor",
          "currency",
          "capacity",
          "coverId"
        ],
        "title": "SourceDocument"
      }
    }
  }
}
