{
  "openapi": "3.1.0",
  "info": {
    "title": "EventFlow Booking",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/sales/{id}": {
      "get": {
        "operationId": "getPublicSale",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicSale"
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders": {
      "post": {
        "operationId": "reserveOrder",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveOrder"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listMyOrders",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          {
            "name": "saleId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderList"
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{id}": {
      "get": {
        "operationId": "getMyOrder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{id}/cancel": {
      "post": {
        "operationId": "cancelMyOrder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PublicSale": {
        "type": "object",
        "required": [
          "id",
          "currency",
          "state",
          "paused",
          "commandVersion",
          "seats",
          "serverNow",
          "salesStartsAt",
          "salesEndsAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "currency": {
            "type": "string",
            "enum": ["EUR"]
          },
          "state": {
            "type": "string",
            "enum": ["SCHEDULED", "OPEN", "PAUSED", "CLOSED"]
          },
          "paused": {
            "type": "boolean"
          },
          "commandVersion": {
            "type": "integer",
            "minimum": 0
          },
          "seats": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "seatId",
                "row",
                "number",
                "categoryId",
                "categoryName",
                "priceMinor",
                "state"
              ],
              "properties": {
                "seatId": {
                  "type": "string"
                },
                "categoryId": {
                  "type": "string"
                },
                "categoryName": {
                  "type": "string"
                },
                "row": {
                  "type": "integer",
                  "minimum": 1
                },
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "priceMinor": {
                  "type": "integer",
                  "minimum": 1
                },
                "state": {
                  "type": "string",
                  "enum": ["AVAILABLE", "HELD", "SOLD"]
                }
              }
            }
          },
          "serverNow": {
            "type": "string",
            "format": "date-time"
          },
          "salesStartsAt": {
            "type": "string",
            "format": "date-time"
          },
          "salesEndsAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": ["code", "message", "requestId", "retryable"],
        "additionalProperties": false
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "saleId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": ["EUR"]
          },
          "totalMinor": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": ["HELD", "CONFIRMED", "EXPIRED", "CANCELLED"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "serverNow": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "seatId": {
                  "type": "string"
                },
                "categoryName": {
                  "type": "string"
                },
                "row": {
                  "type": "integer",
                  "minimum": 1
                },
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "priceMinor": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": ["seatId", "categoryName", "row", "number", "priceMinor"]
            }
          }
        },
        "required": [
          "id",
          "saleId",
          "title",
          "currency",
          "totalMinor",
          "state",
          "createdAt",
          "expiresAt",
          "serverNow",
          "items"
        ]
      },
      "OrderList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "serverNow": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["items", "total", "page", "pageSize", "serverNow"]
      },
      "ReserveOrder": {
        "type": "object",
        "additionalProperties": false,
        "required": ["saleId", "seatIds"],
        "properties": {
          "saleId": {
            "type": "string",
            "format": "uuid"
          },
          "seatIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^r\\d{1,2}-s\\d{1,2}$"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
