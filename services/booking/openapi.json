{
  "openapi": "3.1.0",
  "info": {
    "title": "EventFlow Booking",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/sales/{id}": {
      "get": {
        "operationId": "getPublicSale",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicSale"
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders": {
      "post": {
        "operationId": "reserveOrder",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveOrder"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listMyOrders",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          {
            "name": "saleId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderList"
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{id}": {
      "get": {
        "operationId": "getMyOrder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{id}/cancel": {
      "post": {
        "operationId": "cancelMyOrder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/buyer/orders/{id}/payment-state": {
      "get": {
        "operationId": "getBuyerPaymentState",
        "description": "Internal endpoint; not forwarded by the public BFF.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative order state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentOrder"
                }
              }
            }
          }
        }
      }
    },
    "/internal/orders/{id}/payment-state": {
      "get": {
        "operationId": "getPaymentState",
        "description": "Internal endpoint; not forwarded by the public BFF.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative order state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentOrder"
                }
              }
            }
          }
        }
      }
    },
    "/internal/orders/{id}/payment-authorization": {
      "post": {
        "operationId": "authorizePayment",
        "description": "Internal endpoint; not forwarded by the public BFF.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Authoritative order state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentOrder"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["attemptId", "buyerSubject", "provider"],
                "properties": {
                  "attemptId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "buyerSubject": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "provider": {
                    "enum": ["fake", "stripe"]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{organizationId}/events/{eventId}/orders": {
      "get": {
        "operationId": "getOrganizerOrders",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizerOrderList"
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{organizationId}/events/{eventId}/orders/{id}/refund": {
      "post": {
        "operationId": "requestOrderRefund",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["reason"],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 240
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderRefund"
                }
              }
            }
          },
          "default": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/organizations/{organizationId}/events/{eventId}/order-updates-access": {
      "get": {
        "operationId": "authorizeOrganizerOrderUpdates",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current user may subscribe",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["allowed"],
                  "properties": {
                    "allowed": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Not authorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PublicSale": {
        "type": "object",
        "required": [
          "id",
          "currency",
          "state",
          "paused",
          "commandVersion",
          "seats",
          "serverNow",
          "salesStartsAt",
          "salesEndsAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "currency": {
            "type": "string",
            "enum": ["EUR"]
          },
          "state": {
            "type": "string",
            "enum": ["SCHEDULED", "OPEN", "PAUSED", "CLOSED"]
          },
          "paused": {
            "type": "boolean"
          },
          "commandVersion": {
            "type": "integer",
            "minimum": 0
          },
          "seats": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "seatId",
                "row",
                "number",
                "categoryId",
                "categoryName",
                "priceMinor",
                "state"
              ],
              "properties": {
                "seatId": {
                  "type": "string"
                },
                "categoryId": {
                  "type": "string"
                },
                "categoryName": {
                  "type": "string"
                },
                "row": {
                  "type": "integer",
                  "minimum": 1
                },
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "priceMinor": {
                  "type": "integer",
                  "minimum": 1
                },
                "state": {
                  "type": "string",
                  "enum": ["AVAILABLE", "HELD", "SOLD"]
                }
              }
            }
          },
          "serverNow": {
            "type": "string",
            "format": "date-time"
          },
          "salesStartsAt": {
            "type": "string",
            "format": "date-time"
          },
          "salesEndsAt": {
            "type": "string",
            "format": "date-time"
          },
          "seatMap": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VenueMap"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": ["code", "message", "requestId", "retryable"],
        "additionalProperties": false
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "saleId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": ["EUR"]
          },
          "totalMinor": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": ["HELD", "CONFIRMED", "EXPIRED", "CANCELLED", "REFUNDED"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "serverNow": {
            "type": "string",
            "format": "date-time"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "seatId": {
                  "type": "string"
                },
                "categoryName": {
                  "type": "string"
                },
                "row": {
                  "type": "integer",
                  "minimum": 1
                },
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "priceMinor": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": ["seatId", "categoryName", "row", "number", "priceMinor"]
            }
          },
          "refund": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrderRefund"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "saleId",
          "title",
          "currency",
          "totalMinor",
          "state",
          "createdAt",
          "expiresAt",
          "serverNow",
          "items"
        ]
      },
      "OrderList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "serverNow": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["items", "total", "page", "pageSize", "serverNow"]
      },
      "ReserveOrder": {
        "type": "object",
        "additionalProperties": false,
        "required": ["saleId", "seatIds"],
        "properties": {
          "saleId": {
            "type": "string",
            "format": "uuid"
          },
          "seatIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^r\\d{1,2}-s\\d{1,2}$"
            }
          }
        }
      },
      "PaymentOrder": {
        "type": "object",
        "required": [
          "orderId",
          "buyerSubject",
          "amountMinor",
          "currency",
          "expiresAt",
          "serverNow",
          "state"
        ],
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "buyerSubject": {
            "type": "string"
          },
          "amountMinor": {
            "type": "integer"
          },
          "currency": {
            "const": "EUR"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "serverNow": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "enum": ["HELD", "CONFIRMED", "EXPIRED", "CANCELLED", "REFUNDED"]
          }
        }
      },
      "OrderRefund": {
        "type": "object",
        "required": [
          "id",
          "orderId",
          "reason",
          "state",
          "code",
          "createdAt",
          "updatedAt",
          "completedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "maxLength": 240
          },
          "state": {
            "enum": ["FENCING", "PENDING", "REQUIRES_REVIEW", "REJECTED", "SUCCEEDED"]
          },
          "code": {
            "type": ["string", "null"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      },
      "OrganizerOrder": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Order"
          },
          {
            "type": "object",
            "required": ["refundDeadline", "canRequestRefund"],
            "properties": {
              "refundDeadline": {
                "type": "string",
                "format": "date-time"
              },
              "canRequestRefund": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "OrganizerOrderList": {
        "type": "object",
        "required": ["orders", "total", "page", "pageSize", "pages", "serverNow"],
        "properties": {
          "orders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganizerOrder"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "pages": {
            "type": "integer"
          },
          "serverNow": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "VenueMap": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "const": 1
          },
          "width": {
            "type": "number",
            "minimum": 200,
            "maximum": 10000
          },
          "height": {
            "type": "number",
            "minimum": 200,
            "maximum": 10000
          },
          "seats": {
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "seatId": {
                  "type": "string",
                  "pattern": "^r([1-9]|[1-4]\\d|50)-s([1-9]|[1-4]\\d|50)$"
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000
                },
                "rotation": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              },
              "required": ["seatId", "x", "y", "rotation"],
              "additionalProperties": false
            }
          },
          "features": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,40}$"
                },
                "kind": {
                  "type": "string",
                  "enum": ["stage", "sector", "aisle"]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000
                },
                "width": {
                  "type": "number",
                  "minimum": 20,
                  "maximum": 10000
                },
                "height": {
                  "type": "number",
                  "minimum": 20,
                  "maximum": 10000
                }
              },
              "required": ["id", "kind", "label", "x", "y", "width", "height"],
              "additionalProperties": false
            }
          }
        },
        "required": ["version", "width", "height", "seats", "features"],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
