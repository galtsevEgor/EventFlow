generator client {
  provider = "prisma-client"
  output = "../src/generated"
  moduleFormat = "cjs"
  importFileExtension = "js"
}
datasource db {
  provider = "postgresql"
}
model Sale {
  paused Boolean @default(false)
  commandVersion Int @default(0)
  id String @id @db.Uuid
  organizationId String @db.Uuid
  version Int
  snapshotHash String @db.Char(64)
  title String @db.VarChar(160)
  currency String @db.Char(3)
  timeZone String @db.VarChar(100)
  startsAt DateTime @db.Timestamptz
  endsAt DateTime @db.Timestamptz
  salesStartsAt DateTime @db.Timestamptz
  salesEndsAt DateTime @db.Timestamptz
  admissionStartsAt DateTime @db.Timestamptz
  admissionEndsAt DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  seats SeatInventory[]
}
model SeatInventory {
  state SeatState @default(AVAILABLE)
  currentOrderId String? @db.Uuid
  expiresAt DateTime? @db.Timestamptz(3)
  version Int @default(0)
  saleId String @db.Uuid
  seatId String @db.VarChar(20)
  row Int
  number Int
  categoryId String @db.VarChar(32)
  categoryName String @db.VarChar(60)
  priceMinor Int
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  @@id([saleId, seatId])
  @@unique([saleId, row, number])
}

enum OrderState {
  HELD
  CONFIRMED
  EXPIRED
  CANCELLED
  REFUNDED
}
enum SeatState {
  AVAILABLE
  HELD
  SOLD
}
model Order {
  refund OrderRefund?
  contactEmail Bytes?
  confirmedPaymentId String? @unique @db.VarChar(255)
  confirmedAt DateTime? @db.Timestamptz(3)
  id String @id @db.Uuid
  saleId String @db.Uuid
  buyerSubject String @db.VarChar(255)
  organizationId String @db.Uuid
  title String @db.VarChar(160)
  currency String @db.Char(3)
  totalMinor Int
  state OrderState @default(HELD)
  createdAt DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  items OrderItem[]
  @@unique([id, saleId])
  @@unique([id, saleId, buyerSubject])
  @@index([buyerSubject, createdAt])
  @@index([state, expiresAt])
}
model OrderRefund {
  id String @id @db.Uuid
  orderId String @unique @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorSubject String @db.VarChar(255)
  reason String @db.VarChar(240)
  state String @default("FENCING") @db.VarChar(20)
  code String? @db.VarChar(60)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
}
model RefundRequest {
  actorSubject String @db.VarChar(255)
  key String @db.Uuid
  payloadHash String @db.Char(64)
  operationId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([actorSubject, key])
}
model OrderItem {
  orderId String @db.Uuid
  saleId String @db.Uuid
  seatId String @db.VarChar(20)
  row Int
  number Int
  categoryName String @db.VarChar(60)
  priceMinor Int
  order Order @relation(fields: [orderId, saleId], references: [id, saleId], onDelete: Restrict)
  @@id([orderId, seatId])
}
model BuyerSaleSlot {
  buyerSubject String @db.VarChar(255)
  saleId String @db.Uuid
  currentOrderId String? @db.Uuid
  @@id([buyerSubject, saleId])
}
model ReservationRequest {
  buyerSubject String @db.VarChar(255)
  key String @db.Uuid
  payloadHash String @db.Char(64)
  status Int
  response Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([buyerSubject, key])
}

model Outbox {
  id String @id @db.Uuid
  envelope Json
  availableAt DateTime @default(now()) @db.Timestamptz
  sentAt DateTime? @db.Timestamptz
  lease String? @db.Uuid
  attempts Int @default(0)
  @@index([sentAt, availableAt])
}
model PaymentAuthorization {
  attemptId String @id @db.Uuid
  orderId String @unique @db.Uuid
  provider String @db.VarChar(12)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
model PaymentResult {
  refundState String? @db.VarChar(20)
  providerPaymentId String @id @db.VarChar(255)
  attemptId String @db.Uuid
  orderId String @db.Uuid
  payloadHash String @db.Char(64)
  disposition String @db.VarChar(20)
  operationId String? @unique @db.Uuid
  reason String? @db.VarChar(60)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
model Inbox {
  eventId String @id @db.Uuid
  processedAt DateTime @default(now()) @db.Timestamptz
}
