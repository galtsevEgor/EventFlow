    "/api/v1/waitlist/{id}/updates": {
      "get": {
        "operationId": "subscribeWaitlistUpdates",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE update frames; ready requires a fresh API snapshot. No replay is promised.",
