  "components": {
    "schemas": {
      "WaitlistEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "saleId",
          "title",
          "categoryId",
          "state",
          "orderId",
          "expiresAt",
          "serverNow",
          "position",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "saleId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "WAITING",
              "RESERVING",
              "OFFERED",
              "CANCELLING",
              "PURCHASED",
              "EXPIRED",
              "CANCELLED",
              "SKIPPED",
              "CLOSED"
            ]
          },
          "orderId": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "expiresAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "serverNow": {
            "type": "string",
            "format": "date-time"
          },
          "position": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WaitlistInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled", "state", "categories"],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "state": {
            "type": "string",
            "enum": ["OPEN", "PAUSED", "SCHEDULED", "CLOSED"]
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "WaitlistEntries": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entries"],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WaitlistEntry"
            }
          }
        }
      },
      "WaitlistSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled", "counts", "entries"],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "categoryId", "state", "createdAt"],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "categoryId": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "WaitlistJoin": {
        "type": "object",
        "additionalProperties": false,
        "required": ["saleId", "categoryId"],
        "properties": {
          "saleId": {
            "type": "string",
            "format": "uuid"
          },
          "categoryId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,32}$"
          }
        }
      }
    }
  }
}
