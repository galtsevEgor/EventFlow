    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "@nestjs/platform-express": "12.3.2",
    "@aws-sdk/client-s3": "3.1158.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "jose": "6.2.13",
    "tsx": "4.23.15"
  }
