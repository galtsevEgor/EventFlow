{
  "name": "@eventflow/catalog",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.json",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "generate": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@eventflow/collaboration": "workspace:*",
    "@eventflow/event-contracts": "workspace:*",
    "@eventflow/messaging": "workspace:*",
    "@eventflow/service-runtime": "workspace:*",
    "@eventflow/telemetry": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "jose": "6.2.13",
    "tsx": "4.23.15"
  }
}
