generator client {
  provider = "prisma-client"
  output = "../src/generated"
  moduleFormat = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  MANAGER
  STAFF
}

model Organization {
  id          String @id @default(uuid()) @db.Uuid
  name        String @db.VarChar(100)
  createdBy   String @db.VarChar(128)
  createdAt   DateTime @default(now()) @db.Timestamptz
  memberships Membership[]
  audit       AuditEntry[]
  invitations Invitation[]
  events      EventDraft[]

  @@index([createdBy])
}

model Membership {
  organizationId String @db.Uuid
  userSubject    String @db.VarChar(128)
  email          String @db.VarChar(254)
  role           OrganizationRole
  createdAt      DateTime @default(now()) @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    StaffAssignment[]

  @@id([organizationId, userSubject])
  @@index([userSubject])
}

model AuditEntry {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  actorSubject   String @db.VarChar(128)
  action         String @db.VarChar(64)
  targetId       String @db.VarChar(128)
  details        Json
  createdAt      DateTime @default(now()) @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model Invitation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  email          String @db.VarChar(254)
  role           OrganizationRole
  tokenHash      String @unique @db.Char(64)
  createdBy      String @db.VarChar(128)
  createdAt      DateTime @default(now()) @db.Timestamptz
  expiresAt      DateTime @db.Timestamptz
  acceptedAt     DateTime? @db.Timestamptz
  revokedAt      DateTime? @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
}

model EventDraft {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  title          String @db.VarChar(160)
  description    String @default("") @db.VarChar(5000)
  configuration  Json?
  coverId        String? @db.Uuid
  cover          CoverAsset? @relation("CurrentCover", fields: [coverId], references: [id], onDelete: SetNull)
  publication    Publication?
  assets         CoverAsset[] @relation("EventAssets")
  revision       Int @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    StaffAssignment[]

  @@unique([organizationId, id])
}

model StaffAssignment {
  organizationId String @db.Uuid
  userSubject    String @db.VarChar(128)
  eventId        String @db.Uuid
  membership     Membership @relation(fields: [organizationId, userSubject], references: [organizationId, userSubject], onDelete: Cascade)
  event          EventDraft @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, userSubject, eventId])
}

model CoverAsset {
  id        String @id @default(uuid()) @db.Uuid
  eventId   String @db.Uuid
  objectKey String @unique @db.VarChar(250)
  width     Int
  height    Int
  bytes     Int
  isPublic  Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz
  event     EventDraft @relation("EventAssets", fields: [eventId], references: [id], onDelete: Cascade)
  currentFor EventDraft[] @relation("CurrentCover")

  @@index([eventId])
}

model Publication {
  eventId String @id @db.Uuid
  version Int @default(1)
  state String @default("PROVISIONING") @db.VarChar(20)
  snapshot Json
  snapshotHash String @db.Char(64)
  requestedAt DateTime @default(now()) @db.Timestamptz
  publishedAt DateTime? @db.Timestamptz
  event EventDraft @relation(fields: [eventId], references: [id], onDelete: Restrict)
}

model Outbox {
  id String @id @db.Uuid
  envelope Json
  availableAt DateTime @default(now()) @db.Timestamptz
  sentAt DateTime? @db.Timestamptz
  lease String? @db.Uuid
  attempts Int @default(0)
  @@index([sentAt, availableAt])
}
model Inbox {
  eventId String @id @db.Uuid
  processedAt DateTime @default(now()) @db.Timestamptz
}
